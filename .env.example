# ── Διεύθυνση του site ────────────────────────────────────────────────
# Σε preview (Vercel) βάλτε τη διεύθυνση του preview, π.χ.
#   NEXT_PUBLIC_SITE_URL=https://psichogios-eshop.vercel.app
# Στο go-live:
#   NEXT_PUBLIC_SITE_URL=https://www.psichogiosmeat.gr
NEXT_PUBLIC_SITE_URL=https://www.psichogiosmeat.gr

# ── Ευρετηρίαση στη Google ────────────────────────────────────────────
# ΜΗΝ το ενεργοποιήσετε σε preview: το demo θα έμπαινε στη Google και θα
# δημιουργούσε διπλότυπο περιεχόμενο με το psichogiosmeat.gr.
# Το ανοίγουμε ΜΟΝΟ στο go-live, στο κανονικό domain.
NEXT_PUBLIC_ALLOW_INDEXING=false

# ── WooCommerce ───────────────────────────────────────────────────────
# Ο κατάλογος διαβάζεται από το δημόσιο Store API — δεν χρειάζονται κλειδιά.
NEXT_PUBLIC_WC_BASE_URL=https://shop.psichogiosmeat.gr

# Για τη Φάση 4 (δημιουργία παραγγελιών μέσω REST API v3)
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
